cabal-version:      2.4
name:               minisim
version:            0.1.0.0
synopsis:           A tiny HDL simulator producing WaveDrom JSON
description:
  minisim parses a small Verilog-flavoured HDL (clocks, wires, bit
  selects, user components, built-in dff/latch), simulates it for a
  number of timestamps and emits a WaveDrom JSON timing diagram.
  A companion Python script (wavedrom2svg.py) renders the JSON to SVG.
category:           Hardware
author:             minisim contributors
maintainer:         minisim@example.org
license:            BSD-3-Clause
build-type:         Simple

library
    hs-source-dirs:   src
    exposed-modules:  Minisim.Ast
                    , Minisim.Parser
                    , Minisim.Elab
                    , Minisim.Diagram
                    , Minisim.Sim
                    , Minisim.WaveDrom
    build-depends:    base >=4 && <5
                    , parsec >=3.1 && <3.2
                    , containers >=0.6 && <0.8
                    , mtl >=2.2 && <2.4
    default-language: Haskell2010
    ghc-options:      -Wall

executable minisim
    main-is:          Main.hs
    hs-source-dirs:   app
    build-depends:    base >=4 && <5
                    , minisim
                    , containers >=0.6 && <0.8
                    , parsec >=3.1 && <3.2
    default-language: Haskell2010
    ghc-options:      -Wall

test-suite minisim-test
    type:             exitcode-stdio-1.0
    main-is:          TestMain.hs
    hs-source-dirs:   test
    other-modules:    Support
                    , ParserTests
                    , ElabTests
                    , DiagramTests
                    , SimTests
                    , WaveDromTests
    build-depends:    base >=4 && <5
                    , minisim
                    , containers >=0.6 && <0.8
                    , HUnit >=1.6 && <1.8
    default-language: Haskell2010
    ghc-options:      -Wall
